<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(DeskWidgetsWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(DeskWidgetsMinWindows)</TargetPlatformMinVersion>
    <RootNamespace>DeskWidgets</RootNamespace>
    <AssemblyName>DeskWidgets</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged, with the Windows App SDK copied next to the exe:
         the folder runs anywhere without installing a runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the Windows App SDK parts the app uses. The metapackage would also copy
         the AI, ML and Widgets components (onnxruntime, DirectML) next to the exe.
         Versions are the ones Microsoft.WindowsAppSDK 1.8.260804001 pins. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="1.8.260803002" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <!-- Offscreen DirectWrite colour-font rendering: the Pixel theme shrinks Segoe UI Emoji onto its grid (PixelUi emoji tiles). -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskWidgets.Core\DeskWidgets.Core.csproj" />
    <ProjectReference Include="..\DeskWidgets.Devices\DeskWidgets.Devices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Fusion Pixel Font 8 px (OFL-1.1): the table is embedded, the license travels beside the exe. See tools\Make-FusionFont.ps1. -->
    <EmbeddedResource Include="Assets\Fonts\FusionPixel8-zh_hans.bin" LogicalName="FusionPixel8-zh_hans.bin" />
    <Content Include="Assets\Fonts\OFL-FusionPixel.txt" Link="OFL-FusionPixel.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The pinyin table for the Big Folder search is built from the Unicode Han Database (Unicode License v3). See tools\Make-PinyinTable.ps1. -->
    <EmbeddedResource Include="Assets\Pinyin\pinyin.bin" LogicalName="pinyin.bin" />
    <Content Include="Assets\Pinyin\UNICODE-LICENSE.txt" Link="UNICODE-LICENSE-Unihan.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeskWidgets.Tests" />
  </ItemGroup>

</Project>
