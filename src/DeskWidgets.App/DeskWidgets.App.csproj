<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(DeskWidgetsWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(DeskWidgetsMinWindows)</TargetPlatformMinVersion>
    <RootNamespace>DeskWidgets</RootNamespace>
    <AssemblyName>DeskWidgets</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged, with the Windows App SDK copied next to the exe:
         the folder runs anywhere without installing a runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the Windows App SDK parts the app uses. The metapackage would also copy
         the AI, ML and Widgets components (onnxruntime, DirectML) next to the exe.
         Versions are the ones Microsoft.WindowsAppSDK 1.8.260804001 pins. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="1.8.260803002" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskWidgets.Core\DeskWidgets.Core.csproj" />
    <ProjectReference Include="..\DeskWidgets.Devices\DeskWidgets.Devices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeskWidgets.Tests" />
  </ItemGroup>

</Project>
