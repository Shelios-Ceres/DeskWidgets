<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DeskWidgetsWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(DeskWidgetsMinWindows)</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IsPackable>false</IsPackable>
    <!-- The app assembly loads the Windows App SDK runtime as soon as it is
         touched, so the tests carry the same self-contained runtime with them. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- The app assembly's initializer loads that runtime; a second copy here would clash with it. -->
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- Only the Windows App SDK parts the app uses. The metapackage would also copy
         the AI, ML and Widgets components (onnxruntime, DirectML) next to the exe.
         Versions are the ones Microsoft.WindowsAppSDK 1.8.260804001 pins. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="1.8.260803002" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeskWidgets.App\DeskWidgets.App.csproj" />
    <ProjectReference Include="..\..\src\DeskWidgets.Core\DeskWidgets.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
