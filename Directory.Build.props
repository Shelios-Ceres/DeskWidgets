<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Windows-specific projects share one TFM so WinRT projections line up. -->
    <DeskWidgetsWindowsTfm>net10.0-windows10.0.19041.0</DeskWidgetsWindowsTfm>
    <DeskWidgetsMinWindows>10.0.19041.0</DeskWidgetsMinWindows>
  </PropertyGroup>
</Project>
